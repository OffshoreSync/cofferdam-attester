/**
 * Cofferdam Self attester Worker — Cloudflare config.
 *
 * Holds the SelfAttester ECDSA private key as a Cloudflare-managed secret and
 * signs bind messages for `NullifierRegistry` on Base, after re-verifying the
 * proof's Celo-anchored facts against Self's registry (decision 0004).
 * Strictly service-binding only — `workers_dev: false` and zero `routes`.
 * The only caller is `cofferdam-api`, bound via `services` in its own
 * wrangler.jsonc.
 *
 * Schema reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofferdam-attester",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],

  // Observability — tail-able logs are the audit trail for every sign and
  // every gate rejection. Free tier, 7-day retention; Logpush in production.
  "observability": {
    "enabled": true
  },

  // ── PRIVATE WORKER ──────────────────────────────────────────────
  // No public *.workers.dev URL. No routes. The only way to invoke this
  // Worker is the `services` binding from another Worker in the same
  // Cloudflare account. Even a compromised cofferdam-api can only call the
  // exposed RPC method, never extract the secret.
  "workers_dev": false,

  // Variables — non-secret. Pinned so the attester refuses to sign for the
  // wrong registry, the wrong Base chain, or against the wrong Celo.
  "vars": {
    "ENVIRONMENT": "development",

    // Base Sepolia chain id, part of the signed preimage. Base mainnet
    // ("8453") gets its own attester Worker deploy rather than a second
    // value on this one.
    "BASE_CHAIN_ID": "84532",

    // Sole NullifierRegistry the attester signs for. MUST stay identical to
    // `SEPOLIA_DEPLOYMENTS.NullifierRegistry` in
    // cofferdam-api/src/chain/deployments.ts — divergence makes `signBind`
    // reject every call with REGISTRY_NOT_ALLOWED (it drifted once before).
    //
    // This registry pins expectedScope = Poseidon(cofferdam.xyz ×
    // cofferdam-bind-v1) and selfDestChainId = 42220, both immutable.
    // Requires ATTESTER_PRIVATE_KEY to be the key for
    // 0x2dFDdE621680A270cC01E8D9D729f25a46Bdae59, the sole attester trusted by
    // SelfAttesterRegistry 0x8F3fF40Aa7Eb46b9AB214229D8f7833bbC47ae08. That
    // key lives in TWO places a rotation must both update: the Cloudflare
    // secret (deployed) and .dev.vars (local `wrangler dev`). Rotate with
    // base-contracts/scripts/rotate-self-attester.ts.
    "NULLIFIER_REGISTRY_ADDRESS": "0x2843F55C9E1491a6d47F65f041E68F96E3aeB3d4",

    // ── Celo bind gate ──────────────────────────────────────────
    // Self.xyz anchors its identity-commitment tree and OFAC roots on Celo
    // mainnet. Before signing, the attester confirms over read-only
    // eth_call that the proof's Merkle root is one Self published, that its
    // OFAC roots are current, and that the hub still routes E_PASSPORT to
    // the pinned registry. These four pins change only when Self migrates
    // contracts; verify against self/common/src/constants/constants.ts and
    // `hub.registry(bytes32(1))` before editing.
    //
    // CELO_RPC_URL is a var because forno is public. Moving to a keyed
    // provider means deleting this var and `wrangler secret put CELO_RPC_URL`.
    "CELO_RPC_URL": "https://forno.celo.org",
    // Must equal `SelfApp.chainID` in the app and the registry's
    // selfDestChainId immutable. Self staging (Celo Sepolia 11142220) cannot
    // be used with the current registry.
    "SELF_CELO_CHAIN_ID": "42220",
    // IdentityVerificationHubImplV2 proxy (IDENTITY_VERIFICATION_HUB_ADDRESS).
    "SELF_HUB_ADDRESS": "0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF",
    // IdentityRegistryImplV1 proxy for E_PASSPORT, as `hub.registry(bytes32(1))`
    // reports it (checked live 2026-10-10).
    "SELF_PASSPORT_REGISTRY_ADDRESS": "0x37F5CB8cB1f6B00aa768D8aA99F1A9289802A968"
  }

  // Secrets — set via `wrangler secret put`. NOT in this file.
  //   ATTESTER_PRIVATE_KEY  — 0x-prefixed 32-byte secp256k1 key whose address
  //                           is allow-listed in SelfAttesterRegistry.
}
