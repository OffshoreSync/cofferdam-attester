  "author": "Cofferdam Inc",
  "homepage": "https://github.com/cofferdamxyz/cofferdam-attester#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofferdamxyz/cofferdam-attester.git"
  },
  "bugs": {
    "url": "https://github.com/cofferdamxyz/cofferdam-attester/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "viem": "2.51.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260530.1",
    "@types/node": "26.2.0",
