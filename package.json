{
  "name": "@cofferdam/attester",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cofferdam Self attester Worker — holds the registered SelfAttester ECDSA key as a Cloudflare-managed secret and signs bind messages over Workers RPC after re-verifying the proof against Self.xyz's registry on Celo. Service-binding only, no public URL.",
